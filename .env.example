# ─── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# connect_timeout / pool_timeout stop a slow database from hanging requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zen_amour?schema=public&connect_timeout=10&pool_timeout=10"

# Public URL of the store (used for payment return URLs, webhooks, SEO)
APP_URL="http://localhost:3000"

# Secret used to sign admin sessions. Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# First admin account (created by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@zenamour.co.za"
SEED_ADMIN_PASSWORD=""
# Demo customers, reviews and orders. Set to "false" for a live store.
# Remove demo data later with:  npm run db:clear-demo
SEED_DEMO_DATA="true"

# ─── Yoco (card payments) ────────────────────────────────────────────────
# Secret key from the Yoco portal: sk_test_... for testing, sk_live_... for live
YOCO_SECRET_KEY=""
# Webhook signing secret (whsec_...). Get it by running:  npm run yoco:webhook
YOCO_WEBHOOK_SECRET=""

# ─── Payfast (card, Instant EFT, SnapScan, etc.) ────────────────────────
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
# Passphrase set under Settings → Developer Settings in your Payfast account
PAYFAST_PASSPHRASE=""
# "true" uses sandbox.payfast.co.za
PAYFAST_SANDBOX="true"
# Also check that ITN calls come from Payfast's servers (recommended in live)
PAYFAST_VERIFY_SOURCE_IP="false"

# ─── Pargo (pickup points & courier) ────────────────────────────────────
# These override the values saved in Admin → Settings.
PARGO_USERNAME=""
PARGO_PASSWORD=""
PARGO_MAP_TOKEN=""
# Optional: override the API base URL Pargo gives you for your account
PARGO_API_BASE_URL=""
# Shared secret Pargo appends to webhook calls: /api/webhooks/pargo?secret=...
PARGO_WEBHOOK_SECRET=""

# ─── Email (optional, via Resend) ────────────────────────────────────────
# Order confirmations and shipping updates. Leave blank to log emails instead.
RESEND_API_KEY=""
EMAIL_FROM="Zen Amour <orders@zenamour.co.za>"
# Where new-order alerts go
ORDER_ALERT_EMAIL=""

# ─── Sentry (error monitoring, logs, traces) ────────────────────────────
# DSN from Sentry → Project Settings → Client Keys. The public one is safe in the browser.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: separate server DSN (defaults to the public one)
SENTRY_DSN=""
# e.g. "production", "staging" (defaults to NODE_ENV)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Source-map upload at build time (keep the token secret, set it in CI / your host)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Rate limiting (optional, recommended in production) ────────────────
# Shared counters in Upstash Redis so limits hold across all server instances.
# Without these, each instance keeps its own in-memory counters.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
